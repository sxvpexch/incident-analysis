# incident-analysis configuration.
# Copy to config.env (git-ignored), edit, then run the install scripts. Every manifest is rendered from this file.

# ---------------------------------------------------------------- the application you monitor
CLUSTER_NAME=my-cluster                  # label added to every metric/log from the app cluster
APP_NAMESPACE=shop                       # namespace of the application
APP_DESCRIPTION="the shop app (nginx frontend -> HTTP API -> Postgres)"   # one line, given to the AI as context
API_APP=api                              # app.kubernetes.io/name label of the HTTP API pods
API_DEPLOYMENT=api                       # Deployment name of the API
API_METRICS_PORT=http                    # named container port serving the API's /metrics
FRONTEND_APP=frontend                    # app.kubernetes.io/name of the web frontend ("" if none)
EXCLUDE_ROUTES="unmatched|/healthz|/readyz"  # regex of `route` label values to ignore for latency/error math
APP_INFO_METRIC=app_info                 # optional metric carrying a `version` label
INGRESS_MANIFEST=k8s/ingress.yaml        # where your ingress lives in git (used in "how to fix" commands)
INGRESS_CONTROLLER_NAMESPACE=traefik     # namespace of the Traefik pods (kube-system on k3s)

# ---------------------------------------------------------------- network (private IPs in the same VPC)
MONITORING_SERVER_IP=10.0.0.10           # monitoring server: receives metrics (:30090) and logs (:30100)
APP_NODE_IP=10.0.0.20                    # app cluster control-plane node: Kubernetes API (:6443), controller-manager/scheduler metrics

# ---------------------------------------------------------------- public endpoints
GRAFANA_HOST=grafana.example.com         # DNS name pointing at the monitoring server's public IP
ACME_EMAIL=you@example.com               # Let's Encrypt account email
SITE_PAGE_URL=https://app.example.com/   # outside-in check #1: a page users load
SITE_PAGE_REGEX="<title>My App</title>"  # ...and text that must be in it (proves it's the real page)
SITE_API_URL=https://app.example.com/api/health   # outside-in check #2: an API call through the ingress
SITE_API_REGEX="ok"

# ---------------------------------------------------------------- email (the SMTP password goes in secrets/smtp_password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com             # also the sender address
ALERT_EMAIL_TO=you@example.com           # comma-separated

# ---------------------------------------------------------------- AI
MODEL=deepseek-v2:16b                    # any Ollama model; see docs/lessons-learned.md for why this one
PROJECT_NAME=incident-analysis           # shown in the email header
REGION=                                  # optional, shown in the email footer

# ---------------------------------------------------------------- optional: fault-injection ground truth
# If you break things on purpose, expose a metric naming the injected fault; the email then shows whether
# the diagnosis matched it. The metric is never shown to the analysis or the model.
GROUND_TRUTH_METRIC=                     # e.g. chaos_mode_active
GROUND_TRUTH_LABEL=mode
GROUND_TRUTH_MAP=                        # JSON, e.g. {"error_rate":"APPLICATION ERRORS","db_slow_ms":"DATABASE SLOWNESS"}
